{
  "name": "orchestrator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": "12.5.1"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "echo 'pnpm dev is added in lot 0 step B (server) and step D (UI).'",
    "test": "vitest run",
    "test:e2e": "echo 'pnpm test:e2e is added in lot 0 step D (Playwright).'",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "docs:links": "remark . --quiet --frail --no-stdout",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm docs:links"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.6",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.8",
    "remark-cli": "12.0.1",
    "remark-validate-links": "13.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  }
}
