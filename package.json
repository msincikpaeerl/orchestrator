{
  "name": "orchestrator",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": "12.5.1"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @orchestrator/server --filter @orchestrator/web dev",
    "test": "vitest run",
    "test:e2e": "sh tools/e2e-docker.sh",
    "test:e2e:host": "pnpm --filter @orchestrator/web build && pnpm --filter @orchestrator/web e2e:host",
    "lint": "eslint . && prettier --check . && pnpm lint:shell",
    "lint:shell": "for script in tools/smoke/*.sh; do bash -n \"$script\" || exit 1; done",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "docs:links": "remark . --quiet --frail --no-stdout",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm docs:links"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.6",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.9.8",
    "remark-cli": "12.0.1",
    "remark-validate-links": "13.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  }
}
