# Environment variables of the Orchestrator server (docs/specs/09, section 7.1).
# Copy to .env and fill in. Never commit real values.

# PostgreSQL connection. Used by `pnpm dev`; docker/compose.yml sets its own.
DATABASE_URL=postgres://orchestrator:orchestrator@localhost:5432/orchestrator

# Encryption key for stored secrets (GitHub token). Must be backed up.
# At least 32 characters. Generate one with: openssl rand -base64 32
ORCHESTRATOR_SECRET_KEY=

# URL used in enrollment commands and links. If you change PORT, change the port here too.
# When empty, docker/compose.yml uses http://localhost:<PORT>; `pnpm dev` requires it.
PUBLIC_URL=http://localhost:8080

# HTTP port (default 8080): the port `pnpm dev` listens on, and the host port docker/compose.yml
# publishes the server on (inside its container the server always listens on 8080).
PORT=8080

# Log verbosity: fatal, error, warn, info, debug, trace.
LOG_LEVEL=info
