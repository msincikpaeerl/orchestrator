{
  "name": "@orchestrator/server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "dev": "tsx watch --conditions=source --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js",
    "orchestrator": "tsx --conditions=source --env-file-if-exists=../../.env src/cli.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/static": "10.1.4",
    "@fastify/websocket": "11.3.1",
    "@node-rs/argon2": "2.2.1",
    "@orchestrator/db": "workspace:*",
    "@orchestrator/protocol": "workspace:*",
    "@orchestrator/templates": "workspace:*",
    "@orchestrator/web": "workspace:*",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.1",
    "tsx": "4.23.15",
    "vitest": "5.0.1",
    "ws": "8.21.3"
  }
}
