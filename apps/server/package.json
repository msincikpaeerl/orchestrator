{
  "name": "@orchestrator/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "dev": "tsx watch --conditions=source --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@orchestrator/db": "workspace:*",
    "@orchestrator/protocol": "workspace:*",
    "fastify": "5.12.5",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "vitest": "5.0.1"
  }
}
